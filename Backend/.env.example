# psql/GUI clients: these URLs use sslmode=verify-full, so run psql with
# PGSSLROOTCERT=system to verify against macOS trusted roots. Do not put
# sslrootcert=system in the URL itself — the Node pg driver reads it as a file.
# Direct (non-pooled) connection — used by Prisma migrations.
# Local: postgresql://YOUR_USER@localhost:5432/ownurpet
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
# Pooled connection (host has -pooler) — used by the app at runtime. Optional;
# falls back to DATABASE_URL.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
PORT=4000
# Password for the seeded admin@gmail.com account
SEED_ADMIN_PASSWORD="change-me"
# Optional: creates demo@pawcliniq.in with this password (local testing only;
# leave unset for production).
SEED_DEMO_PASSWORD=""
# Signs session cookies. Generate with: openssl rand -base64 48
JWT_SECRET="change-me"
